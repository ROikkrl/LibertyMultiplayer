 CClient * g_pClient = NULL;
 
+namespace
+{
+void OnCompleteEditionFrame(const ivmp_ce::Engine& engine)
+{
+    const auto now = GetTickCount64();
+    if (CGame::GetPools())
+    {
+        CGame::RefreshCompleteEditionPools();
+        ivmp_ce::SessionRuntime::Instance().Tick(engine, now);
+        return;
+    }
+
+    static ULONGLONG nextProbe = 0;
+    if (now < nextProbe) return;
+    nextProbe = now + 100;
+
+    const auto pools = engine.Pools();
+    if (!pools || !*pools.peds || !*pools.vehicles) return;
+    ivmp_ce::LocalPlayer player;
+    if (!ivmp_ce::LocalPlayerReader(engine).Read(player)) return;
+    const auto ped = pools.ResolvePed(player.ped);
+    if (!ped || pools.encode(*pools.peds, ped) != player.ped) return;
+
+    CGame::RefreshCompleteEditionPools();
+    OutputDebugStringW(L"IV:MP CE: game thread and entity pools ready.\n");
+}
+}
